# Copie ce fichier en .env et remplis les valeurs (ne jamais commiter .env)
COMINTY_API_KEY=sk-cmt-...
COMINTY_USER_ID=user_...

# Identifiants des 4 agents créés sur platform.cominty.ai -> Agents
PROFILER_AGENT_ID=
AUDITOR_AGENT_ID=
REMEDIATOR_AGENT_ID=
REPORTER_AGENT_ID=

# Intégration Slack (optionnelle). Connecte Slack sur platform.cominty.ai -> Intégrations,
# puis indique le canal. SLACK_CONNECTION est le nom affiché sur la page Intégrations (souvent "slack").
SLACK_CHANNEL=#data-clinic
SLACK_CONNECTION=slack
